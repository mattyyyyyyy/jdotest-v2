{
  "name": "@jdo/api",
  "version": "0.1.0",
  "description": "后端 modular monolith（Fastify + zod）— 消费端 /api/v1/* + 后台 /api/v1/admin/*",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
