# 环境变量模板 · 真密钥永不入仓（见 backend-spec.md §五 / constraints.md）
# 用法：cp .env.example .env.local 后填本地值；敏感值生产走 secret manager。

# ── 后端 API (services/api) ──
API_PORT=3000
# PostgreSQL（ADR-0003）。本地 docker compose 默认；生产走 secret manager
DATABASE_URL=postgresql://jdo:replace-me-local-password@localhost:5432/jdo
# Redis（购物车 / 会话缓存）
REDIS_URL=redis://localhost:6379
# store SQLite 实库持久化（ADR-0014，better-sqlite3；PG 接入前的过渡）。
# 设置后重启不丢数据；不设则纯内存（测试默认）。生产目标仍是上面的 PostgreSQL。
# STORE_PERSIST_PATH=./.data/store.db
# JWT（access 15min / refresh 7d）。真值只走 secret manager，勿提交
JWT_ACCESS_SECRET=replace-me-with-32-plus-char-random-secret
JWT_REFRESH_SECRET=replace-me-with-another-32-plus-char-secret
# 支付（Demo mock，不接真实微信/支付宝/银联）
PAYMENT_MODE=mock

# ── 前端 H5 (apps/h5) ── 仅 VITE_PUBLIC_* 暴露给浏览器
VITE_PUBLIC_API_BASE=http://localhost:3000/api/v1
# 行车态阈值 km/h（ADR-0004；本地可用 URL 参数 ?speed=20 覆盖）
VITE_PUBLIC_DRIVING_SPEED_THRESHOLD=5

# ── 后台 admin ──
# admin JWT 签名密钥（与消费端 JWT 不同 secret；生产走 secret manager）
ADMIN_JWT_SECRET=replace-me-with-32-plus-char-admin-secret
# 超管初始账号（仅本地 seed；生产首次登录强制改密）
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-me-local-only
